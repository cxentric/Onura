# Copy to .env for local development. Everything prefixed VITE_ is bundled into the browser
# app, so only public values go here.

# Supabase → Project Settings → API. Leave empty to run without accounts (every feature free).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server secrets are NOT set here. Add them in Cloudflare Pages → Settings → Variables and Secrets
# (or in .dev.vars for `npx wrangler pages dev`):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
#   RAZORPAY_PLAN_MONTHLY, RAZORPAY_PLAN_YEARLY
